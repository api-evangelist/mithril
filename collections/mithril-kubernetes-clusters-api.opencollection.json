              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get all Kubernetes clusters for a project"
        },
        {
          "info": {
            "name": "Create Kubernetes Cluster",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mithril.ai/v2/kubernetes/clusters",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a new Kubernetes cluster"
        },
        {
          "info": {
            "name": "Get Kubernetes Cluster",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mithril.ai/v2/kubernetes/clusters/:cluster_fid",
            "params": [
              {
                "name": "cluster_fid",
